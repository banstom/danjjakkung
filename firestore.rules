rules_version = '2';

// 단짝꿍 Firestore 접근 규칙
// - 아래 두 이메일로 로그인하고, 메일 인증까지 마친 사람만 읽고 쓸 수 있다
// - 이메일은 꼭 소문자로 적는다
// - 각자 자기 이름(members), 자기 루틴(routines), 자기 루틴의 체크(checks)만 바꿀 수 있다
// Firebase 콘솔 › Firestore Database › 규칙 탭에 그대로 붙여 넣고 [게시]
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['__EMAIL_1__', '__EMAIL_2__'];
    }

    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function routineOwner(key) {
      return get(/databases/$(database)/documents/routines/$(key)).data.owner;
    }

    // 체크하는 날짜: 루틴 시작일 이후이고, 내일(한국 시간 기준 여유 포함)보다 앞
    function notFuture(dateStr) {
      let p = dateStr.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])) < request.time + duration.value(1, 'd');
    }

    // 사람 이름: 자기 문서만, 한 번 만들면 바꾸지 않는다
    match /members/{uid} {
      allow read: if isMember();
      allow create: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'joinedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 10;
      allow update, delete: if false;
    }

    // 루틴: 만든 사람(owner)만 고치고 지운다
    function validRoutine() {
      let d = request.resource.data;
      return d.keys().hasOnly(['icon', 'name', 'who', 'owner', 'start', 'end', 'order', 'updatedAt'])
        && d.owner == request.auth.uid
        && d.name is string && d.name.size() > 0 && d.name.size() <= 20
        && d.icon is string && d.icon.size() <= 8
        && isDate(d.start)
        && (d.end == null || isDate(d.end));
    }
    match /routines/{key} {
      allow read: if isMember();
      allow create: if isMember() && validRoutine();
      allow update: if isMember() && resource.data.owner == request.auth.uid && validRoutine();
      allow delete: if isMember() && resource.data.owner == request.auth.uid;
    }

    // 체크: 자기 루틴만, 문서 이름은 <루틴>_<날짜>, 체크한 사람(by)은 자기 자신
    match /checks/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['routine', 'date', 'done', 'by', 'byUid', 'at'])
        && request.resource.data.done == true
        && request.resource.data.by == request.auth.uid
        && (request.resource.data.byUid == null || request.resource.data.byUid == request.auth.uid)
        && request.resource.data.at is string && request.resource.data.at.size() <= 40
        && isDate(request.resource.data.date)
        && notFuture(request.resource.data.date)
        && id == request.resource.data.routine + '_' + request.resource.data.date
        && routineOwner(request.resource.data.routine) == request.auth.uid
        && request.resource.data.date >= get(/databases/$(database)/documents/routines/$(request.resource.data.routine)).data.start;
      // 지우기: 내가 남긴 체크만 (이미 없는 문서를 지우는 것도 허용 — 두 기기에서 동시에 지운 경우)
      allow delete: if isMember() && (resource == null || resource.data.by == request.auth.uid);
    }

    // ── 할 일 ──  함께(together)는 둘 다, 각자 것은 본인만 쓰고 지운다. 읽기는 둘 다.
    function validTodo(d) {
      return d.keys().hasOnly(['scope', 'title', 'due', 'done', 'doneBy', 'doneAt', 'createdBy', 'createdAt', 'updatedAt'])
        && d.scope is string && d.title is string && d.title.size() > 0 && d.title.size() <= 40
        && (d.due == null || isDate(d.due))
        && ((d.done == true && d.doneBy is string && d.doneAt is string) || (d.done == false && d.doneBy == null && d.doneAt == null))
        && d.createdBy is string && d.createdAt is string && d.updatedAt is string;
    }
    function mineOrTogether(scope) { return scope == 'together' || scope == request.auth.uid; }
    match /todos/{id} {
      allow read: if isMember();
      allow create: if isMember() && validTodo(request.resource.data) && mineOrTogether(request.resource.data.scope)
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.done == false || request.resource.data.doneBy == request.auth.uid);
      allow update: if isMember() && validTodo(request.resource.data) && mineOrTogether(resource.data.scope)
        && request.resource.data.scope == resource.data.scope
        && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.done == false || request.resource.data.doneBy == request.auth.uid
            || (resource.data.done == true && request.resource.data.doneBy == resource.data.doneBy && request.resource.data.doneAt == resource.data.doneAt));
      // (이미 없는 문서를 지우는 것도 허용 — 두 기기에서 동시에 지운 경우)
      allow delete: if isMember() && (resource == null || mineOrTogether(resource.data.scope));
    }

    // ── 시간표 ──  내 일정은 나만, 함께(both) 일정은 둘 다 쓰고 지운다. 읽기는 둘 다.
    function validEvent(d) {
      // 매주 · 요일 하나: weekday 숫자 / 매주 · 요일 여럿: weekday null + weekdays 목록(2~7개, 0~6) / 한 번: date
      return d.keys().hasOnly(['owner', 'title', 'weekly', 'weekday', 'weekdays', 'date', 'start', 'end', 'createdBy', 'updatedAt'])
        && d.owner is string && d.title is string && d.title.size() > 0 && d.title.size() <= 20
        && ((d.weekly == true && d.date == null && !('weekdays' in d) && d.weekday is int && d.weekday >= 0 && d.weekday <= 6)
            || (d.weekly == true && d.date == null && d.weekday == null && ('weekdays' in d) && d.weekdays is list
                && d.weekdays.size() >= 2 && d.weekdays.size() <= 7 && d.weekdays.hasOnly([0, 1, 2, 3, 4, 5, 6])
                && d.weekdays.toSet().size() == d.weekdays.size())
            || (d.weekly == false && d.weekday == null && !('weekdays' in d) && isDate(d.date)))
        && d.start is string && d.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.end is string && d.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && d.end > d.start
        && d.createdBy is string && d.updatedAt is string;
    }
    function mineOrBoth(owner) { return owner == 'both' || owner == request.auth.uid; }
    match /events/{id} {
      allow read: if isMember();
      allow create: if isMember() && validEvent(request.resource.data) && mineOrBoth(request.resource.data.owner)
        && request.resource.data.createdBy == request.auth.uid;
      // 함께 일정은 함께 일정으로 남는다 (한 사람이 자기 것으로 가져갈 수 없음). 내 일정은 함께로 바꿀 수 있다.
      allow update: if isMember() && validEvent(request.resource.data) && mineOrBoth(resource.data.owner) && mineOrBoth(request.resource.data.owner)
        && (request.resource.data.owner == resource.data.owner || resource.data.owner == request.auth.uid)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isMember() && (resource == null || mineOrBoth(resource.data.owner));
    }

    // ── 알림 ──
    // users/<uid>: 내 알림 설정. 나만 읽고 쓴다.
    function validNotify(n) {
      return n is map && n.keys().hasOnly(['partner', 'remindAt', 'hide'])
        && n.partner is bool && n.hide is bool
        && (n.remindAt == null || (n.remindAt is string && n.remindAt.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')));
    }
    match /users/{uid} {
      allow read: if isMember() && request.auth.uid == uid;
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['notify', 'tz', 'updatedAt'])
        && validNotify(request.resource.data.notify);
      allow delete: if false;

      // 알림 받을 기기 (기기마다 하나 — 웹 · 나중에 iOS/안드로이드 앱)
      match /devices/{dev} {
        allow read, delete: if isMember() && request.auth.uid == uid;
        allow create, update: if isMember() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'platform', 'ua', 'updatedAt'])
          && request.resource.data.token is string && request.resource.data.token.size() > 0 && request.resource.data.token.size() < 4096
          && request.resource.data.platform in ['web', 'ios', 'android']
          && request.resource.data.ua is string && request.resource.data.ua.size() <= 80;
      }
      // 테스트 알림 요청 (서버가 보고 지운다)
      match /pings/{pid} {
        allow create: if isMember() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at is string && request.resource.data.at.size() <= 40;
      }
    }
    // notifyLog: 서버만 쓴다 (규칙에 없으므로 앱에서는 읽기 · 쓰기 모두 막힘)
  }
}
