rules_version = '2';

// 단짝꿍 Firestore 접근 규칙
// - 아래 두 이메일로 로그인하고, 메일 인증까지 마친 사람만 읽고 쓸 수 있다
// - 이메일은 꼭 소문자로 적는다
// - 각자 자기 이름(members), 자기 루틴(routines), 자기 루틴의 체크(checks)만 바꿀 수 있다
// - 시간표 카테고리(cats)는 둘이 같이 쓰고 같이 고친다
// Firebase 콘솔 › Firestore Database › 규칙 탭에 그대로 붙여 넣고 [게시]
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['__EMAIL_1__', '__EMAIL_2__'];
    }

    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function routineOwner(key) {
      return get(/databases/$(database)/documents/routines/$(key)).data.owner;
    }

    // 체크하는 날짜: 루틴 시작일 이후이고, 내일(한국 시간 기준 여유 포함)보다 앞
    function notFuture(dateStr) {
      let p = dateStr.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])) < request.time + duration.value(1, 'd');
    }

    // 사람 이름: 자기 문서만, 한 번 만들면 바꾸지 않는다
    match /members/{uid} {
      allow read: if isMember();
      allow create: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'joinedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 10;
      allow update, delete: if false;
    }

    // 루틴: 만든 사람(owner)만 고치고 지운다
    function validRoutine() {
      let d = request.resource.data;
      return d.keys().hasOnly(['icon', 'name', 'who', 'owner', 'start', 'end', 'order', 'updatedAt'])
        && d.owner == request.auth.uid
        && d.name is string && d.name.size() > 0 && d.name.size() <= 20
        && d.icon is string && d.icon.size() <= 8
        && isDate(d.start)
        && (d.end == null || isDate(d.end));
    }
    match /routines/{key} {
      allow read: if isMember();
      allow create: if isMember() && validRoutine();
      allow update: if isMember() && resource.data.owner == request.auth.uid && validRoutine();
      allow delete: if isMember() && resource.data.owner == request.auth.uid;
    }

    // 체크: 자기 루틴만, 문서 이름은 <루틴>_<날짜>, 체크한 사람(by)은 자기 자신
    match /checks/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['routine', 'date', 'done', 'by', 'byUid', 'at'])
        && request.resource.data.done == true
        && request.resource.data.by == request.auth.uid
        && (request.resource.data.byUid == null || request.resource.data.byUid == request.auth.uid)
        && request.resource.data.at is string && request.resource.data.at.size() <= 40
        && isDate(request.resource.data.date)
        && notFuture(request.resource.data.date)
        && id == request.resource.data.routine + '_' + request.resource.data.date
        && routineOwner(request.resource.data.routine) == request.auth.uid
        && request.resource.data.date >= get(/databases/$(database)/documents/routines/$(request.resource.data.routine)).data.start;
      // 지우기: 내가 남긴 체크만 (이미 없는 문서를 지우는 것도 허용 — 두 기기에서 동시에 지운 경우)
      allow delete: if isMember() && (resource == null || resource.data.by == request.auth.uid);
    }

    // ── 할 일 ──  함께(together)는 둘 다, 각자 것은 본인만 쓰고 지운다. 읽기는 둘 다.
    // u&I 위치: 사람마다 { u: 급한 정도, i: 중요한 정도 (0~1), at: 놓은 때 }
    function validPlace(v) {
      return v is map && v.keys().hasOnly(['u', 'i', 'at'])
        && v.u is number && v.u >= 0 && v.u <= 1 && v.i is number && v.i >= 0 && v.i <= 1
        && v.at is string && v.at.size() <= 40;
    }
    // ui 는 내 칸만 바꿀 수 있다 (짝꿍이 놓은 위치는 그대로)
    function uiOk(n, o) {
      let nu = n.get('ui', {});
      let ou = o.get('ui', {});
      return nu is map && nu.size() <= 2 && nu.diff(ou).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in nu) || validPlace(nu[request.auth.uid]));
    }
    function validTodo(d) {
      return d.keys().hasOnly(['scope', 'title', 'due', 'done', 'doneBy', 'doneAt', 'createdBy', 'createdAt', 'updatedAt', 'cat', 'ui', 'short'])
        && (d.get('short', null) == null || (d.short is string && d.short.size() > 0 && d.short.size() <= 8))
        && (d.get('cat', null) == null || (d.cat is string && d.cat.matches('^[a-z0-9]{1,24}$')))
        && d.scope is string && d.title is string && d.title.size() > 0 && d.title.size() <= 40
        && (d.due == null || isDate(d.due))
        && ((d.done == true && d.doneBy is string && d.doneAt is string) || (d.done == false && d.doneBy == null && d.doneAt == null))
        && d.createdBy is string && d.createdAt is string && d.updatedAt is string;
    }
    function mineOrTogether(scope) { return scope == 'together' || scope == request.auth.uid; }
    match /todos/{id} {
      allow read: if isMember();
      allow create: if isMember() && validTodo(request.resource.data) && mineOrTogether(request.resource.data.scope)
        && request.resource.data.createdBy == request.auth.uid
        && uiOk(request.resource.data, {})
        && (request.resource.data.done == false || request.resource.data.doneBy == request.auth.uid);
      allow update: if isMember() && validTodo(request.resource.data) && mineOrTogether(resource.data.scope)
        && request.resource.data.scope == resource.data.scope && uiOk(request.resource.data, resource.data)
        && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.done == false || request.resource.data.doneBy == request.auth.uid
            || (resource.data.done == true && request.resource.data.doneBy == resource.data.doneBy && request.resource.data.doneAt == resource.data.doneAt));
      // (이미 없는 문서를 지우는 것도 허용 — 두 기기에서 동시에 지운 경우)
      allow delete: if isMember() && (resource == null || mineOrTogether(resource.data.scope));
    }

    // u&I 기록 (궤적 · 회고용): 남기기만 하고 고치거나 지우지 않는다
    match /uiLog/{id} {
      allow read: if isMember();
      allow create: if isMember() && id.matches('^[a-z0-9]{1,24}$')
        && request.resource.data.keys().hasOnly(['todo', 'by', 'type', 'u', 'i', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.todo is string && request.resource.data.todo.size() > 0 && request.resource.data.todo.size() <= 40
        && request.resource.data.type in ['add', 'move', 'done', 'undo', 'delete']
        && (request.resource.data.get('u', null) == null || (request.resource.data.u is number && request.resource.data.u >= 0 && request.resource.data.u <= 1))
        && (request.resource.data.get('i', null) == null || (request.resource.data.i is number && request.resource.data.i >= 0 && request.resource.data.i <= 1))
        && request.resource.data.at is string && request.resource.data.at.size() <= 40;
      allow update, delete: if false;
    }

    // 꿍 보내기: 하루에 한 번, 각자 짝꿍에게 (문서 이름 = <날짜>_<보내는 사람 uid> 라서 같은 날 두 번째는 막힌다)
    // 남기기만 하고 고치거나 지우지 않는다. 서버가 문서가 생기면 짝꿍에게 알림을 보낸다.
    match /kungs/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['from', 'to', 'date', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && exists(/databases/$(database)/documents/members/$(request.resource.data.to))
        && isDate(request.resource.data.date)
        && id == request.resource.data.date + '_' + request.auth.uid
        && notFuture(request.resource.data.date)
        && timestamp.date(int(request.resource.data.date.split('-')[0]), int(request.resource.data.date.split('-')[1]), int(request.resource.data.date.split('-')[2])) > request.time - duration.value(2, 'd')
        && request.resource.data.at is string && request.resource.data.at.size() <= 40;
      allow update, delete: if false;
    }

    // ── 시간표 ──  내 일정은 나만, 함께(both) 일정은 둘 다 쓰고 지운다. 읽기는 둘 다.
    // 요일마다 시간: { '1': '10:00-11:00', '3': '16:00-17:00' } — 끝이 시작보다 늦어야
    function validSpan(v) {
      return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$') && v.split('-')[0] < v.split('-')[1];
    }
    function validTimes(t) {
      return t is map && t.keys().hasOnly(['0', '1', '2', '3', '4', '5', '6'])
        && (!('0' in t) || validSpan(t['0'])) && (!('1' in t) || validSpan(t['1'])) && (!('2' in t) || validSpan(t['2']))
        && (!('3' in t) || validSpan(t['3'])) && (!('4' in t) || validSpan(t['4'])) && (!('5' in t) || validSpan(t['5']))
        && (!('6' in t) || validSpan(t['6']));
    }
    function validEvent(d) {
      // 매주 · 요일 하나: weekday 숫자 / 매주 · 요일 여럿: weekday null + weekdays 목록(2~7개, 0~6) / 한 번: date
      return d.keys().hasOnly(['owner', 'title', 'short', 'weekly', 'weekday', 'weekdays', 'times', 'cat', 'skip', 'date', 'start', 'end', 'createdBy', 'updatedAt'])
        // 쉬는 날: 매주 일정만, 날짜 1~60개 (날짜 모양은 앱이 거른다)
        && (!('skip' in d) || (d.weekly == true && d.skip is list && d.skip.size() >= 1 && d.skip.size() <= 60 && isDate(d.skip[0]) && isDate(d.skip[d.skip.size() - 1])))
        && (!('short' in d) || (d.short is string && d.short.size() > 0 && d.short.size() <= 10))
        // 카테고리: id 만 (기본 6개 또는 cats 에 새로 만든 것 — 지운 카테고리 id 가 남아 있어도 된다)
        && (!('cat' in d) || (d.cat is string && d.cat.matches('^[a-z0-9]{1,24}$')))
        && (!('times' in d) || (('weekdays' in d) && validTimes(d.times) && d.times.size() == d.weekdays.size()))
        && d.owner is string && d.title is string && d.title.size() > 0 && d.title.size() <= 20
        && ((d.weekly == true && d.date == null && !('weekdays' in d) && d.weekday is int && d.weekday >= 0 && d.weekday <= 6)
            || (d.weekly == true && d.date == null && d.weekday == null && ('weekdays' in d) && d.weekdays is list
                && d.weekdays.size() >= 2 && d.weekdays.size() <= 7 && d.weekdays.hasOnly([0, 1, 2, 3, 4, 5, 6])
                && d.weekdays.toSet().size() == d.weekdays.size())
            || (d.weekly == false && d.weekday == null && !('weekdays' in d) && isDate(d.date)))
        && d.start is string && d.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.end is string && d.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && d.end > d.start
        && d.createdBy is string && d.updatedAt is string;
    }
    function mineOrBoth(owner) { return owner == 'both' || owner == request.auth.uid; }
    match /events/{id} {
      allow read: if isMember();
      allow create: if isMember() && validEvent(request.resource.data) && mineOrBoth(request.resource.data.owner)
        && request.resource.data.createdBy == request.auth.uid;
      // 함께 일정은 함께 일정으로 남는다 (한 사람이 자기 것으로 가져갈 수 없음). 내 일정은 함께로 바꿀 수 있다.
      allow update: if isMember() && validEvent(request.resource.data) && mineOrBoth(resource.data.owner) && mineOrBoth(request.resource.data.owner)
        && (request.resource.data.owner == resource.data.owner || resource.data.owner == request.auth.uid)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isMember() && (resource == null || mineOrBoth(resource.data.owner));
    }

    // ── 시간표 카테고리 ──  둘이 같이 쓰는 목록. 둘 다 만들고 · 고치고 · 지운다. (js/cats.js)
    // 이름 · 아이콘이 있는 문서, 또는 기본 카테고리를 지운 표시 { deleted: true }
    function validCat(d) {
      return d.keys().hasOnly(['name', 'icon', 'order', 'deleted', 'updatedBy', 'updatedAt'])
        && d.updatedBy == request.auth.uid && d.updatedAt is string && d.updatedAt.size() <= 40
        && ((('deleted' in d) && d.deleted == true && !('name' in d) && !('icon' in d) && !('order' in d))
            || (!('deleted' in d)
                && d.name is string && d.name.size() > 0 && d.name.size() <= 8
                && d.icon is string && d.icon.size() > 0 && d.icon.size() <= 8
                && d.order is int && d.order >= 0 && d.order <= 999));
    }
    match /cats/{id} {
      allow read: if isMember();
      allow create, update: if isMember() && id.matches('^[a-z0-9]{1,24}$') && validCat(request.resource.data);
      allow delete: if isMember();
    }

    // ── 알림 ──
    // users/<uid>: 내 알림 설정. 나만 읽고 쓴다.
    function validNotify(n) {
      return n is map && n.keys().hasOnly(['partner', 'remindAt', 'hide'])
        && n.partner is bool && n.hide is bool
        && (n.remindAt == null || (n.remindAt is string && n.remindAt.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')));
    }
    // colors: 테마마다 내 화면에서 쓸 나 · 상대 색 { '<테마 id>': { self: '#RRGGBB', partner: '#RRGGBB' } }
    // 내 화면에만 쓰인다 (상대 화면과는 무관). 테마 목록은 js/themes.js 와 같아야 한다.
    function validPair(p) {
      return p is map && p.keys().hasOnly(['self', 'partner'])
        && (!('self' in p) || (p.self is string && p.self.matches('^#[0-9A-F]{6}$')))
        && (!('partner' in p) || (p.partner is string && p.partner.matches('^#[0-9A-F]{6}$')));
    }
    function validColors(c) {
      return c is map && c.keys().hasOnly(['soft-pastel', 'cosmic-dream', 'ocean-breeze', 'forest-diary', 'vintage-film', 'blue-hour', 'golden-hour', 'sakura-dream', 'midnight-noir', 'arctic-frost', 'chocolate-noir', 'roast-nuts', 'winter-knit', 'harvest'])
        && (!('soft-pastel' in c) || validPair(c['soft-pastel']))
        && (!('cosmic-dream' in c) || validPair(c['cosmic-dream']))
        && (!('ocean-breeze' in c) || validPair(c['ocean-breeze']))
        && (!('forest-diary' in c) || validPair(c['forest-diary']))
        && (!('vintage-film' in c) || validPair(c['vintage-film']))
        && (!('blue-hour' in c) || validPair(c['blue-hour']))
        && (!('golden-hour' in c) || validPair(c['golden-hour']))
        && (!('sakura-dream' in c) || validPair(c['sakura-dream']))
        && (!('midnight-noir' in c) || validPair(c['midnight-noir']))
        && (!('arctic-frost' in c) || validPair(c['arctic-frost']))
        && (!('chocolate-noir' in c) || validPair(c['chocolate-noir']))
        && (!('roast-nuts' in c) || validPair(c['roast-nuts']))
        && (!('winter-knit' in c) || validPair(c['winter-knit']))
        && (!('harvest' in c) || validPair(c['harvest']));
    }
    match /users/{uid} {
      allow read: if isMember() && request.auth.uid == uid;
      // 알림 설정과 색은 따로 저장된다 (어느 한쪽만 있는 문서도 된다)
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['notify', 'tz', 'colors', 'updatedAt'])
        && (!('notify' in request.resource.data) || validNotify(request.resource.data.notify))
        && (!('colors' in request.resource.data) || validColors(request.resource.data.colors));
      allow delete: if false;

      // 알림 받을 기기 (기기마다 하나 — 웹 · 나중에 iOS/안드로이드 앱)
      match /devices/{dev} {
        allow read, delete: if isMember() && request.auth.uid == uid;
        allow create, update: if isMember() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'platform', 'ua', 'updatedAt'])
          && request.resource.data.token is string && request.resource.data.token.size() > 0 && request.resource.data.token.size() < 4096
          && request.resource.data.platform in ['web', 'ios', 'android']
          && request.resource.data.ua is string && request.resource.data.ua.size() <= 80;
      }
      // 테스트 알림 요청 (서버가 보고 지운다)
      match /pings/{pid} {
        allow create: if isMember() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at is string && request.resource.data.at.size() <= 40;
      }
    }
    // notifyLog: 서버만 쓴다 (규칙에 없으므로 앱에서는 읽기 · 쓰기 모두 막힘)
  }
}
