rules_version = '2';

// 단짝꿍 Firestore 접근 규칙
// - 아래 두 이메일로 로그인하고, 메일 인증까지 마친 사람만 읽고 쓸 수 있다
// - 이메일은 꼭 소문자로 적는다
// - 각자 자기 이름(members), 자기 루틴(routines), 자기 루틴의 체크(checks)만 바꿀 수 있다
// - 시간표 카테고리(cats)는 둘이 같이 쓰고 같이 고친다
// Firebase 콘솔 › Firestore Database › 규칙 탭에 그대로 붙여 넣고 [게시]
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['__EMAIL_1__', '__EMAIL_2__'];
    }

    function validSpend(d) {
      return d.keys().hasOnly(['date', 'amount', 'paidBy', 'shares', 'what', 'cat', 'raw', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.amount is int && d.amount >= 1 && d.amount < 100000000
        && isDate(d.date)
        && (d.cat in ['meal', 'cafe', 'move', 'stay', 'play', 'shop', 'etc']
          || (d.cat is string && d.cat.matches('^c[a-z0-9]{2,23}$') && exists(/databases/$(database)/documents/spendCats/$(d.cat))))
        && d.what is string && d.what.size() >= 1 && d.what.size() <= 40
        && (!('raw' in d) || (d.raw is string && d.raw.size() <= 80))
        && d.createdAt is string && d.createdAt.size() <= 40 && d.updatedAt is string && d.updatedAt.size() <= 40
        && d.createdBy is string && d.updatedBy is string
        && validPayer(d);
    }
    function validPayer(d) {
      return (d.paidBy is string && d.paidBy != 'both' && !('shares' in d) && exists(/databases/$(database)/documents/members/$(d.paidBy)))
        || (d.paidBy == 'both' && d.shares is map && d.shares.size() == 2 && validShares(d.shares, d.shares.keys(), d.amount));
    }
    function validShares(s, k, amount) {
      return exists(/databases/$(database)/documents/members/$(k[0])) && exists(/databases/$(database)/documents/members/$(k[1]))
        && s[k[0]] is int && s[k[1]] is int && s[k[0]] >= 1 && s[k[1]] >= 1 && s[k[0]] + s[k[1]] == amount;
    }
    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function routineOwner(key) {
      return get(/databases/$(database)/documents/routines/$(key)).data.owner;
    }

    // 체크하는 날짜: 루틴 시작일 이후이고, 내일(한국 시간 기준 여유 포함)보다 앞
    function notFuture(dateStr) {
      let p = dateStr.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])) < request.time + duration.value(1, 'd');
    }

    // 사람 이름: 자기 문서만, 한 번 만들면 바꾸지 않는다
    match /members/{uid} {
      allow read: if isMember();
      allow create: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'joinedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 10;
      allow update, delete: if false;
    }

    // 루틴: 만든 사람(owner)만 고치고 지운다
    function validRoutine() {
      let d = request.resource.data;
      return d.keys().hasOnly(['icon', 'name', 'who', 'owner', 'start', 'end', 'order', 'rest', 'when', 'kind', 'updatedAt'])
        && d.owner == request.auth.uid
        // 쉬기 (v38): [{ from, to|null }] 30개까지 — 기간 하나하나는 규칙에서 반복 검사를 못 해 앱이 정리하고 이상한 값은 화면에서 무시한다
        && (!('rest' in d) || (d.rest is list && d.rest.size() <= 30))
        // 종류 (v44): 아이콘대로가 아닐 때만 — null 이면 아이콘대로
        && (!('kind' in d) || d.kind == null || d.kind in ['move', 'study', 'health', 'life', 'mind'])
        // 언제 할지 (v41): { cue?: 20자, at?: 'HH:MM', remind?: bool } 또는 null(언제든)
        && (!('when' in d) || d.when == null || (d.when is map
            && d.when.keys().hasOnly(['cue', 'at', 'remind'])
            && (!('cue' in d.when) || (d.when.cue is string && d.when.cue.size() >= 1 && d.when.cue.size() <= 20))
            && (!('at' in d.when) || (d.when.at is string && d.when.at.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
            && (!('remind' in d.when) || d.when.remind is bool)))
        && d.name is string && d.name.size() > 0 && d.name.size() <= 20
        && d.icon is string && d.icon.size() <= 8
        && isDate(d.start)
        && (d.end == null || isDate(d.end));
    }
    match /routines/{key} {
      allow read: if isMember();
      allow create: if isMember() && validRoutine();
      allow update: if isMember() && resource.data.owner == request.auth.uid && validRoutine();
      allow delete: if isMember() && resource.data.owner == request.auth.uid;
    }

    // 체크: 자기 루틴만, 문서 이름은 <루틴>_<날짜>, 체크한 사람(by)은 자기 자신
    match /checks/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['routine', 'date', 'done', 'by', 'byUid', 'at'])
        && request.resource.data.done == true
        && request.resource.data.by == request.auth.uid
        && (request.resource.data.byUid == null || request.resource.data.byUid == request.auth.uid)
        && request.resource.data.at is string && request.resource.data.at.size() <= 40
        && isDate(request.resource.data.date)
        && notFuture(request.resource.data.date)
        && id == request.resource.data.routine + '_' + request.resource.data.date
        && routineOwner(request.resource.data.routine) == request.auth.uid
        && request.resource.data.date >= get(/databases/$(database)/documents/routines/$(request.resource.data.routine)).data.start;
      // 지우기: 내가 남긴 체크만 (이미 없는 문서를 지우는 것도 허용 — 두 기기에서 동시에 지운 경우)
      allow delete: if isMember() && (resource == null || resource.data.by == request.auth.uid);
    }

    // ── 할 일 ──  함께(together)는 둘 다, 각자 것은 본인만 쓰고 지운다. 읽기는 둘 다.
    // u&I 위치: 사람마다 { u: 급한 정도, i: 중요한 정도 (0~1), at: 놓은 때 }
    function validPlace(v) {
      return v is map && v.keys().hasOnly(['u', 'i', 'at'])
        && v.u is number && v.u >= 0 && v.u <= 1 && v.i is number && v.i >= 0 && v.i <= 1
        && v.at is string && v.at.size() <= 40;
    }
    // ui 는 내 칸만 바꿀 수 있다 (짝꿍이 놓은 위치는 그대로)
    function uiOk(n, o) {
      let nu = n.get('ui', {});
      let ou = o.get('ui', {});
      return nu is map && nu.size() <= 2 && nu.diff(ou).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in nu) || validPlace(nu[request.auth.uid]));
    }
    function validTodo(d) {
      return d.keys().hasOnly(['scope', 'title', 'due', 'done', 'doneBy', 'doneAt', 'createdBy', 'createdAt', 'updatedAt', 'cat', 'ui', 'short', 'memo'])
        // 메모: 1~200자 (여러 줄)
        && (d.get('memo', null) == null || (d.memo is string && d.memo.size() > 0 && d.memo.size() <= 200))
        && (d.get('short', null) == null || (d.short is string && d.short.size() > 0 && d.short.size() <= 8))
        && (d.get('cat', null) == null || (d.cat is string && d.cat.matches('^[a-z0-9]{1,24}$')))
        && d.scope is string && d.title is string && d.title.size() > 0 && d.title.size() <= 40
        && (d.due == null || isDate(d.due))
        && ((d.done == true && d.doneBy is string && d.doneAt is string) || (d.done == false && d.doneBy == null && d.doneAt == null))
        && d.createdBy is string && d.createdAt is string && d.updatedAt is string;
    }
    function mineOrTogether(scope) { return scope == 'together' || scope == request.auth.uid; }
    match /todos/{id} {
      allow read: if isMember();
      allow create: if isMember() && validTodo(request.resource.data) && mineOrTogether(request.resource.data.scope)
        && request.resource.data.createdBy == request.auth.uid
        && uiOk(request.resource.data, {})
        && (request.resource.data.done == false || request.resource.data.doneBy == request.auth.uid);
      allow update: if isMember() && validTodo(request.resource.data) && mineOrTogether(resource.data.scope)
        && request.resource.data.scope == resource.data.scope && uiOk(request.resource.data, resource.data)
        && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.done == false || request.resource.data.doneBy == request.auth.uid
            || (resource.data.done == true && request.resource.data.doneBy == resource.data.doneBy && request.resource.data.doneAt == resource.data.doneAt));
      // (이미 없는 문서를 지우는 것도 허용 — 두 기기에서 동시에 지운 경우)
      allow delete: if isMember() && (resource == null || mineOrTogether(resource.data.scope));
    }

    // u&I 기록 (궤적 · 회고용): 남기기만 하고 고치거나 지우지 않는다
    match /uiLog/{id} {
      allow read: if isMember();
      allow create: if isMember() && id.matches('^[a-z0-9]{1,24}$')
        && request.resource.data.keys().hasOnly(['todo', 'by', 'type', 'u', 'i', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.todo is string && request.resource.data.todo.size() > 0 && request.resource.data.todo.size() <= 40
        && request.resource.data.type in ['add', 'move', 'done', 'undo', 'delete']
        && (request.resource.data.get('u', null) == null || (request.resource.data.u is number && request.resource.data.u >= 0 && request.resource.data.u <= 1))
        && (request.resource.data.get('i', null) == null || (request.resource.data.i is number && request.resource.data.i >= 0 && request.resource.data.i <= 1))
        && request.resource.data.at is string && request.resource.data.at.size() <= 40;
      allow update, delete: if false;
    }

    // 꿍 보내기: 하루에 한 번, 각자 짝꿍에게 (문서 이름 = <날짜>_<보내는 사람 uid> 라서 같은 날 두 번째는 막힌다)
    // 남기기만 하고 고치거나 지우지 않는다. 서버가 문서가 생기면 짝꿍에게 알림을 보낸다.
    match /kungs/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['from', 'to', 'date', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && exists(/databases/$(database)/documents/members/$(request.resource.data.to))
        && isDate(request.resource.data.date)
        && id == request.resource.data.date + '_' + request.auth.uid
        && notFuture(request.resource.data.date)
        && timestamp.date(int(request.resource.data.date.split('-')[0]), int(request.resource.data.date.split('-')[1]), int(request.resource.data.date.split('-')[2])) > request.time - duration.value(2, 'd')
        && request.resource.data.at is string && request.resource.data.at.size() <= 40;
      allow update, delete: if false;
    }

    // ── 시간표 ──  내 일정은 나만, 함께(both) 일정은 둘 다 쓰고 지운다. 읽기는 둘 다.
    // 요일마다 시간: { '1': '10:00-11:00', '3': '16:00-17:00' } — 끝이 시작보다 늦어야
    function validSpan(v) {
      return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$') && v.split('-')[0] < v.split('-')[1];
    }
    function validTimes(t) {
      return t is map && t.keys().hasOnly(['0', '1', '2', '3', '4', '5', '6'])
        && (!('0' in t) || validSpan(t['0'])) && (!('1' in t) || validSpan(t['1'])) && (!('2' in t) || validSpan(t['2']))
        && (!('3' in t) || validSpan(t['3'])) && (!('4' in t) || validSpan(t['4'])) && (!('5' in t) || validSpan(t['5']))
        && (!('6' in t) || validSpan(t['6']));
    }
    function validEvent(d) {
      // 매주 · 요일 하나: weekday 숫자 / 매주 · 요일 여럿: weekday null + weekdays 목록(2~7개, 0~6) / 한 번: date
      return d.keys().hasOnly(['owner', 'title', 'short', 'weekly', 'weekday', 'weekdays', 'times', 'cat', 'skip', 'moved', 'solo', 'more', 'from', 'until', 'last', 'date', 'start', 'end', 'createdBy', 'updatedAt'])
        // 시작 날짜: 매주 일정만 (이 날짜 앞의 주에는 안 보임)
        && (!('from' in d) || (d.weekly == true && isDate(d.from)))
        // 마지막 주(월요일): 매주 일정만, 시작 주가 있고 그보다 앞이 아님 (같으면 이번 주만)
        && (!('until' in d) || (d.weekly == true && isDate(d.until) && ('from' in d) && d.until >= d.from))
        // 마지막 날(이 날 포함): 매주 일정만, 시작 주가 있고 그보다 앞이 아님
        && (!('last' in d) || (d.weekly == true && isDate(d.last) && ('from' in d) && d.last >= d.from))
        // 쉬는 날: 매주 일정만, 날짜 1~60개 (날짜 모양은 앱이 거른다)
        && (!('skip' in d) || (d.weekly == true && d.skip is list && d.skip.size() >= 1 && d.skip.size() <= 60 && isDate(d.skip[0]) && isDate(d.skip[d.skip.size() - 1])))
        // 그날만 바뀐 시간: 매주 일정만, { 'YYYY-MM-DD': 'HH:MM-HH:MM' } 1~60개 (날짜 · 시간 모양은 앱이 거른다)
        && (!('moved' in d) || (d.weekly == true && d.moved is map && d.moved.size() >= 1 && d.moved.size() <= 60))
        // 그날만 혼자 (v78): 함께 일정만, { 'YYYY-MM-DD': <멤버 uid> } 1~60개 (날짜 · 요일은 앱이 거른다)
        && (!('solo' in d) || (d.owner == 'both' && d.solo is map && d.solo.size() >= 1 && d.solo.size() <= 60))
        // 하루에 한 번 더: 'HH:MM-HH:MM' 1~3개 (겹치는지는 앱이 거른다)
        && (!('more' in d) || (d.more is list && d.more.size() >= 1 && d.more.size() <= 3 && validSpan(d.more[0]) && validSpan(d.more[d.more.size() - 1])))
        && (!('short' in d) || (d.short is string && d.short.size() > 0 && d.short.size() <= 10))
        // 카테고리: id 만 (기본 6개 또는 cats 에 새로 만든 것 — 지운 카테고리 id 가 남아 있어도 된다)
        && (!('cat' in d) || (d.cat is string && d.cat.matches('^[a-z0-9]{1,24}$')))
        && (!('times' in d) || (('weekdays' in d) && validTimes(d.times) && d.times.size() == d.weekdays.size()))
        && d.owner is string && d.title is string && d.title.size() > 0 && d.title.size() <= 20
        && ((d.weekly == true && d.date == null && !('weekdays' in d) && d.weekday is int && d.weekday >= 0 && d.weekday <= 6)
            || (d.weekly == true && d.date == null && d.weekday == null && ('weekdays' in d) && d.weekdays is list
                && d.weekdays.size() >= 2 && d.weekdays.size() <= 7 && d.weekdays.hasOnly([0, 1, 2, 3, 4, 5, 6])
                && d.weekdays.toSet().size() == d.weekdays.size())
            || (d.weekly == false && d.weekday == null && !('weekdays' in d) && isDate(d.date)))
        && d.start is string && d.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.end is string && d.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && d.end > d.start
        && d.createdBy is string && d.updatedAt is string;
    }
    function mineOrBoth(owner) { return owner == 'both' || owner == request.auth.uid; }
    match /events/{id} {
      allow read: if isMember();
      allow create: if isMember() && validEvent(request.resource.data) && mineOrBoth(request.resource.data.owner)
        && request.resource.data.createdBy == request.auth.uid;
      // 함께 일정은 함께 일정으로 남는다 (한 사람이 자기 것으로 가져갈 수 없음). 내 일정은 함께로 바꿀 수 있다.
      allow update: if isMember() && validEvent(request.resource.data) && mineOrBoth(resource.data.owner) && mineOrBoth(request.resource.data.owner)
        && (request.resource.data.owner == resource.data.owner || resource.data.owner == request.auth.uid)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isMember() && (resource == null || mineOrBoth(resource.data.owner));
    }

    // ── 시간표 카테고리 ──  둘이 같이 쓰는 목록. 둘 다 만들고 · 고치고 · 지운다. (js/cats.js)
    // 이름 · 아이콘이 있는 문서, 또는 기본 카테고리를 지운 표시 { deleted: true }
    function validCat(d) {
      return d.keys().hasOnly(['name', 'icon', 'order', 'deleted', 'updatedBy', 'updatedAt'])
        && d.updatedBy == request.auth.uid && d.updatedAt is string && d.updatedAt.size() <= 40
        && ((('deleted' in d) && d.deleted == true && !('name' in d) && !('icon' in d) && !('order' in d))
            || (!('deleted' in d)
                && d.name is string && d.name.size() > 0 && d.name.size() <= 8
                && d.icon is string && d.icon.size() > 0 && d.icon.size() <= 8
                && d.order is int && d.order >= 0 && d.order <= 999));
    }
    match /cats/{id} {
      allow read: if isMember();
      allow create, update: if isMember() && id.matches('^[a-z0-9]{1,24}$') && validCat(request.resource.data);
      allow delete: if isMember();
    }

    // 우리 기념일 (v46): couple/main 하나 — 둘 다 읽고 고친다 (지우기는 없음)
    match /couple/{id} {
      allow read: if isMember();
      allow create, update: if isMember() && id == 'main'
        && request.resource.data.keys().hasOnly(['start', 'label', 'box', 'updatedBy', 'updatedAt'])
        && (!('box' in request.resource.data) || request.resource.data.box in ['heart', 'overlap', 'badge', 'ticket', 'polaroid']) // v52 박스 모양 (v53부터 앱은 안 씀 — 예전 값 읽기용으로 남김)
        && request.resource.data.start is string && request.resource.data.start.matches('^(19[5-9][0-9]|20[0-9][0-9])-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && request.resource.data.label is string && request.resource.data.label.size() > 0 && request.resource.data.label.size() <= 8
        && (request.resource.data.updatedBy == request.auth.uid
          || (resource != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['box']))) // v52 모양만 바꿀 땐 「누가 정했는지」 그대로
        && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40;
      allow delete: if false;
    }

    // 단짝 지도 (v48): places/<시군구코드> — 둘이 함께 다녀온 곳 · 가고 싶은 곳. 둘 다 읽고 고친다 (지우기는 없음)
    //  visits 는 앱이 날짜 순으로 저장 → 맨 앞(가장 이른 날)이 단짝이 된 날보다 이르면 막는다
    //  v54: 별점 · 메모는 방문마다 각자 — entries.<uid>.<visitId> = { stars, note, at }. 각자 자기 칸만 고친다
    //   (예외: 방문 지우기 — 같은 쓰기에서 visits 가 줄면 두 사람의 그 방문 기록을 함께 지울 수 있다)
    //   옛 지역 별점 stars 와 visits[].note 는 받지 않는다 (scripts/migrate-place-entries.js 로 옮긴 뒤)
    function coupleStart() {
      return exists(/databases/$(database)/documents/couple/main)
        ? get(/databases/$(database)/documents/couple/main).data.start : '1950-01-01';
    }
    function validVisit(v) {
      return v is map && v.keys().hasOnly(['id', 'date', 'createdAt', 'createdBy'])
        && isDate(v.date) && v.id is string && v.id.size() <= 24;
    }
    function validMapEntry(e) {
      return e is map && e.keys().hasOnly(['stars', 'note', 'at'])
        && (e.get('stars', null) == null || (e.stars is int && e.stars >= 1 && e.stars <= 5))
        && e.get('note', '') is string && e.get('note', '').size() <= 100
        && (e.get('at', null) == null || (e.at is string && e.at.size() <= 40));
    }
    // 내 칸만 바뀜(방문을 지울 때는 예외) · 사람 둘까지 · 내 기록 100개까지 · 가장 최근 방문의 내 기록은 모양까지 검사
    function validEntries(n, o, vs, ovs) {
      let mine = n.get(request.auth.uid, {});
      let lastId = vs.size() > 0 ? vs[vs.size() - 1].id : '';
      return n is map && n.size() <= 2 && mine is map && mine.size() <= 100
        && (n.diff(o).affectedKeys().hasOnly([request.auth.uid]) || vs.size() < ovs.size())
        && (!(lastId in mine) || validMapEntry(mine[lastId]));
    }
    // 맨 앞(가장 이른 방문)이 그대로면 통과 — 단짝이 된 날을 나중에 정해도 그 전 기록이 있는 문서가 얼어붙지 않게
    // (이름 주의: validPlace 는 할 일 평면 ui 칸에서 이미 씀 — 같은 이름이면 규칙 컴파일이 실패한다)
    function validMapPlace(code, d, o) {
      let vs = d.get('visits', []);
      return d.keys().hasOnly(['code', 'wishRank', 'wishNote', 'wishedAt', 'wishedBy', 'visits', 'entries', 'updatedAt', 'updatedBy'])
        && d.code == code
        && d.updatedBy == request.auth.uid && d.updatedAt is string && d.updatedAt.size() <= 40
        && (d.get('wishRank', null) == null || d.wishRank is number)
        && d.get('wishNote', '') is string && d.get('wishNote', '').size() <= 100
        && vs is list && vs.size() <= 100
        && (vs.size() == 0 || (validVisit(vs[0]) && validVisit(vs[vs.size() - 1])
            && (vs[0].date >= coupleStart() || (o.get('visits', []).size() > 0 && vs[0] == o.visits[0]))))
        && validEntries(d.get('entries', {}), o.get('entries', {}), vs, o.get('visits', []));
    }
    match /places/{code} {
      allow read: if isMember();
      allow create: if isMember() && code.matches('^[0-9]{5}$') && validMapPlace(code, request.resource.data, {});
      allow update: if isMember() && validMapPlace(code, request.resource.data, resource.data);
      allow delete: if false;
    }

    // 단짝 식탁(private · goals · meals · foods)은 11-20 폐기, 11-23 데이터까지 지움 (scripts/delete-diet-data.js) — 규칙도 뺌 (없으면 막힘)

    // 프로필 사진 (v51): avatars/<uid> — 256px JPEG 를 data URL 글자로 (Storage 없이). 둘 다 읽고 본인만 올리고 지움
    match /avatars/{uid} {
      allow read: if isMember();
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['img', 'updatedAt'])
        && request.resource.data.img is string && request.resource.data.img.size() <= 120000
        && request.resource.data.img.split(',')[0] == 'data:image/jpeg;base64'
        && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40;
      allow delete: if isMember() && request.auth.uid == uid;
    }

    // ── 알림 ──
    // users/<uid>: 내 알림 설정. 나만 읽고 쓴다.
    function validNotify(n) {
      return n is map && n.keys().hasOnly(['partner', 'remindAt', 'hide'])
        && n.partner is bool && n.hide is bool
        && (n.remindAt == null || (n.remindAt is string && n.remindAt.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')));
    }
    // colors: 테마마다 내 화면에서 쓸 나 · 상대 색 { '<테마 id>': { self: '#RRGGBB', partner: '#RRGGBB' } }
    // 내 화면에만 쓰인다 (상대 화면과는 무관). 테마 목록은 js/themes.js 와 같아야 한다.
    function validPair(p) {
      return p is map && p.keys().hasOnly(['self', 'partner'])
        && (!('self' in p) || (p.self is string && p.self.matches('^#[0-9A-F]{6}$')))
        && (!('partner' in p) || (p.partner is string && p.partner.matches('^#[0-9A-F]{6}$')));
    }
    // 테마마다 고른 사람 색. 11/19 겨울 도트 테마(winter-snack · merry-xmas)는 낮 · 밤 판을 묶음 id 하나로 저장
    function validColors(c) {
      return c is map && c.keys().hasOnly(['soft-pastel', 'cosmic-dream', 'ocean-breeze', 'forest-diary', 'vintage-film', 'blue-hour', 'golden-hour', 'sakura-dream', 'midnight-noir', 'arctic-frost', 'chocolate-noir', 'roast-nuts', 'winter-knit', 'harvest', 'winter-snack', 'merry-xmas', 'spring-picnic', 'summer-sea', 'autumn-forest', 'observatory', 'train-trip'])
        && (!('soft-pastel' in c) || validPair(c['soft-pastel']))
        && (!('cosmic-dream' in c) || validPair(c['cosmic-dream']))
        && (!('ocean-breeze' in c) || validPair(c['ocean-breeze']))
        && (!('forest-diary' in c) || validPair(c['forest-diary']))
        && (!('vintage-film' in c) || validPair(c['vintage-film']))
        && (!('blue-hour' in c) || validPair(c['blue-hour']))
        && (!('golden-hour' in c) || validPair(c['golden-hour']))
        && (!('sakura-dream' in c) || validPair(c['sakura-dream']))
        && (!('midnight-noir' in c) || validPair(c['midnight-noir']))
        && (!('arctic-frost' in c) || validPair(c['arctic-frost']))
        && (!('chocolate-noir' in c) || validPair(c['chocolate-noir']))
        && (!('roast-nuts' in c) || validPair(c['roast-nuts']))
        && (!('winter-knit' in c) || validPair(c['winter-knit']))
        && (!('harvest' in c) || validPair(c['harvest']))
        && (!('winter-snack' in c) || validPair(c['winter-snack']))
        && (!('merry-xmas' in c) || validPair(c['merry-xmas']))
        && (!('spring-picnic' in c) || validPair(c['spring-picnic']))
        && (!('summer-sea' in c) || validPair(c['summer-sea']))
        && (!('autumn-forest' in c) || validPair(c['autumn-forest']))
        && (!('observatory' in c) || validPair(c['observatory']))
        && (!('train-trip' in c) || validPair(c['train-trip']));
    }
    match /users/{uid} {
      allow read: if isMember() && request.auth.uid == uid;
      // 알림 설정과 색은 따로 저장된다 (어느 한쪽만 있는 문서도 된다)
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['notify', 'tz', 'colors', 'weekly', 'todoNotify', 'missNotify', 'mapNudge', 'routineView', 'reviewMonthView', 'recap', 'qRemind', 'qPartner', 'eatDrawN', 'eatDrawWho', 'eatSeenAt', 'updatedAt'])
        && (!('notify' in request.resource.data) || validNotify(request.resource.data.notify))
        && (!('weekly' in request.resource.data) || request.resource.data.weekly is bool)
        && (!('recap' in request.resource.data) || request.resource.data.recap is bool) // 매달 1일 결산 알림 (없으면 켬)
        && (!('todoNotify' in request.resource.data) || request.resource.data.todoNotify is bool)
        && (!('missNotify' in request.resource.data) || request.resource.data.missNotify is bool)
        && (!('routineView' in request.resource.data) || request.resource.data.routineView in ['time', 'kind', 'manual'])
        && (!('mapNudge' in request.resource.data) || request.resource.data.mapNudge is bool)
        && (!('reviewMonthView' in request.resource.data) || request.resource.data.reviewMonthView in ['card', 'strip'])
        && (!('qRemind' in request.resource.data) || request.resource.data.qRemind is bool)   // 교환 쪽지 저녁 9시 (없으면 켬)
        && (!('qPartner' in request.resource.data) || request.resource.data.qPartner is bool) // 교환 쪽지 단짝이 남기면 (없으면 켬)
        && (!('eatDrawN' in request.resource.data) || request.resource.data.eatDrawN in [1, 2, 3]) // 출출 쿠키 마지막 깨기 개수
        && (!('eatDrawWho' in request.resource.data) || request.resource.data.eatDrawWho in ['all', 'me', 'partner'])
        && (!('eatSeenAt' in request.resource.data) || request.resource.data.eatSeenAt is number) // 쿠키 통을 연 시각(ms) — 입구 「단짝 +n」
        && (!('colors' in request.resource.data) || validColors(request.resource.data.colors));
      allow delete: if false;

      // 알림 받을 기기 (기기마다 하나 — 웹 · 나중에 iOS/안드로이드 앱)
      match /devices/{dev} {
        allow read, delete: if isMember() && request.auth.uid == uid;
        allow create, update: if isMember() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'platform', 'ua', 'updatedAt'])
          && request.resource.data.token is string && request.resource.data.token.size() > 0 && request.resource.data.token.size() < 4096
          && request.resource.data.platform in ['web', 'ios', 'android']
          && request.resource.data.ua is string && request.resource.data.ua.size() <= 80;
      }
      // 테스트 알림 요청 (서버가 보고 지운다)
      match /pings/{pid} {
        allow create: if isMember() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at is string && request.resource.data.at.size() <= 40;
      }
    }
    // 단짝 영수증 (docs/ledger): spends/<id> — 함께 쓴 돈. 둘 다 적고 · 고치고 · 지울 수 있다
    //   paidBy = 낸 사람 uid, 또는 'both' + shares { uid: 몫, uid: 몫 } (두 몫 합 = amount, 둘 다 1원 이상)
    match /spends/{id} {
      allow read, delete: if isMember();
      allow create: if isMember() && validSpend(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid;
      allow update: if isMember() && validSpend(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    // 영수증 분류 직접 만들기: spendCats/<c + 영문 소문자 · 숫자> — 둘이 같은 목록, 이름 1~8자. 지우면 그 분류 기록은 화면에서 기타로
    match /spendCats/{id} {
      allow read, delete: if isMember();
      allow create: if isMember() && id.matches('^c[a-z0-9]{2,23}$')
        && request.resource.data.keys().hasOnly(['name', 'order', 'createdBy', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 8
        && request.resource.data.order is int && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
      allow update: if false;
    }
    // ── 교환 쪽지 (docs/question/spec.md 11절, 코드 이름 question) ──
    //   qdays/{서울 날짜} 그날 질문 · qdays/{date}/a/{uid} 사람마다 쪽지(내 쪽지가 있어야 단짝 쪽지를 get) · ourQuestions 우리가 넣은 질문
    match /qdays/{date} {
      function me() { return request.auth.uid; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function answerPath(uid) { return /databases/$(database)/documents/qdays/$(date)/a/$(uid); }

      allow read: if isMember();

      // 그날 처음 연 사람(또는 서버 함수)이 만듦. 클라이언트는 트랜잭션으로 '없을 때만' 만들기
      allow create: if isMember()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['q', 'text', 'src', 'by', 'skipped', 'done', 'likes', 'createdAt'])
        && request.resource.data.src in ['base', 'ours', 'date']
        && request.resource.data.q is string
        && request.resource.data.text is string && request.resource.data.text.size() <= 120
        && request.resource.data.skipped.size() == 0
        && request.resource.data.done.size() == 0
        && request.resource.data.likes.size() == 0
        && request.resource.data.createdAt == request.time;

      allow update: if isMember() && (isSwap() || isMarkDone() || isLike());
      allow delete: if false;

      // 「다른 질문」: 기본/날짜 질문 · 아직 아무도 안 답함 · 한 번만. (오늘인지는 기기 시계라 화면에서 막음)
      function isSwap() {
        return changed().hasOnly(['q', 'text', 'src', 'by', 'skipped', 'swappedAt', 'swappedBy'])
          && resource.data.src in ['base', 'date']
          && request.resource.data.src == 'base'
          && resource.data.get('swappedAt', null) == null
          && resource.data.done.size() == 0
          && request.resource.data.swappedAt == request.time
          && request.resource.data.swappedBy == me()
          && request.resource.data.skipped == resource.data.skipped.concat([resource.data.q]);
      }

      // 답을 처음 남길 때 같은 batch로 done.{내 uid} = serverTimestamp
      function isMarkDone() {
        return changed().hasOnly(['done'])
          && !(me() in resource.data.done)
          && request.resource.data.done.diff(resource.data.done).affectedKeys().hasOnly([me()])
          && request.resource.data.done[me()] == request.time
          && existsAfter(answerPath(me()));
      }

      // 「마음에 남아요」: 둘 다 답한 날, 내 칸(likes.{내 uid})만
      function isLike() {
        return changed().hasOnly(['likes'])
          && request.resource.data.likes.diff(resource.data.likes).affectedKeys().hasOnly([me()])
          && (me() in resource.data.done)
          && resource.data.done.size() == 2;
      }

      match /a/{uid} {
        // 내 답은 늘, 단짝 답은 내 답이 있을 때만. 목록 조회(list)는 막고 문서 하나씩 get
        allow get: if isMember() && (me() == uid || exists(answerPath(me())));
        allow list: if false;

        allow create: if isMember() && me() == uid && validAnswer()
          && request.resource.data.at == request.time
          && !('editedAt' in request.resource.data)
          && getAfter(/databases/$(database)/documents/qdays/$(date)).data.done[uid] == request.time;

        allow update: if isMember() && me() == uid && validAnswer()
          && request.resource.data.at == resource.data.at
          && request.resource.data.editedAt == request.time;

        allow delete: if false;

        function validAnswer() {
          return request.resource.data.keys().hasOnly(['text', 'at', 'editedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 300;
        }
      }
    }

    match /ourQuestions/{id} {
      function validQ() {
        return request.resource.data.text is string
          && request.resource.data.text.size() >= 2
          && request.resource.data.text.size() <= 60
          && request.resource.data.ask is bool;
      }
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['text', 'by', 'ask', 'createdAt'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.createdAt == request.time
        && validQ();
      // 낸 사람만. '이미 나온 질문은 못 고침'은 화면에서 막음(나온 날의 글은 days/{date}.text에 따로 남아 있음)
      allow update: if isMember() && resource.data.by == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'ask'])
        && validQ();
      allow delete: if isMember() && resource.data.by == request.auth.uid;
    }

    // ── 짝꿍과의 연말 문답 (docs/yearqa/spec.md) ──
    //   yearqa/{YYYY} = { sealed: { uid: 시각 } } 봉투 붙인 표시 · yearqa/{YYYY}/a/{uid} 사람마다 답
    //   짝꿍 답 get = 둘 다 봉투를 붙였고 다음 해 1월 1일 0시(서울)가 지났을 때만. 목록 조회 막음. 지우기 없음
    match /yearqa/{year} {
      function yqMe() { return request.auth.uid; }
      function yqMine() { return /databases/$(database)/documents/yearqa/$(year)/a/$(request.auth.uid); }
      function yqRevealed() { return request.time >= timestamp.date(int(year) + 1, 1, 1) - duration.value(9, 'h'); }
      function yqSealedAfter() { return existsAfter(yqMine()) && getAfter(yqMine()).data.sealed == true; }

      allow read: if isMember();
      allow create: if isMember() && year.matches('^20[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['sealed'])
        && request.resource.data.sealed.keys().hasOnly([yqMe()])
        && request.resource.data.sealed[yqMe()] == request.time
        && yqSealedAfter();
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sealed'])
        && !(yqMe() in resource.data.sealed)
        && request.resource.data.sealed.diff(resource.data.sealed).affectedKeys().hasOnly([yqMe()])
        && request.resource.data.sealed[yqMe()] == request.time
        && yqSealedAfter();
      allow delete: if false;

      match /a/{uid} {
        allow get: if isMember() && (yqMe() == uid
          || (resource.data.sealed == true && yqRevealed()
            && exists(yqMine()) && get(yqMine()).data.sealed == true));
        allow list: if false;
        allow create, update: if isMember() && yqMe() == uid && year.matches('^20[0-9]{2}$') && validYearAnswer()
          && (resource == null || resource.data.sealed != true || request.resource.data.sealed == true);
        allow delete: if false;

        function validYearAnswer() {
          return request.resource.data.keys().hasOnly(['answers', 'sealed', 'updatedAt', 'sealedAt'])
            && request.resource.data.answers is map
            && request.resource.data.answers.size() <= 40
            && request.resource.data.sealed is bool
            && request.resource.data.updatedAt == request.time
            && (!('sealedAt' in request.resource.data) || request.resource.data.sealed == true);
        }
      }
    }

    // ── 출출 쿠키 (docs/eat/spec.md 4절, 코드 이름 eat) ──
    //   eats/{id} 쿠키 · eatState/today 오늘 먹을 것 하나 · eatDraws/{id} 깨기 기록
    //   글자 수의 정확한 검사는 앱(js/eat.js), 규칙은 넉넉한 상한만
    function eatStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function eatPlaceOk(p) {
      return p == null || (p is map
        && p.keys().hasOnly(['name', 'kakaoId', 'url', 'sigungu'])
        && eatStr(p.name, 1, 120)
        && (!('kakaoId' in p) || (p.kakaoId is string && p.kakaoId.matches('^[0-9]{1,20}$')))
        && (!('url' in p) || (p.url is string && p.url.matches('^https://place[.]map[.]kakao[.]com/[0-9]+$')))
        && (!('sigungu' in p) || (p.sigungu is string && p.sigungu.matches('^[0-9]{5}$'))));
    }

    function eatContentOk(d) {
      return eatStr(d.food, 1, 60)
        && (!('memo' in d) || d.memo == null || eatStr(d.memo, 0, 300))
        && (!('place' in d) || eatPlaceOk(d.place));
    }

    // 별점 · 한 줄은 자기 칸(uid 키)만 바꿀 수 있다
    function eatOwnScores(uid) {
      let before = resource.data.get('stars', {});
      let after = request.resource.data.get('stars', {});
      let nb = resource.data.get('notes', {});
      let na = request.resource.data.get('notes', {});
      return after.diff(before).affectedKeys().hasOnly([uid])
        && (!(uid in after) || (after[uid] is int && after[uid] >= 1 && after[uid] <= 5))
        && na.diff(nb).affectedKeys().hasOnly([uid])
        && (!(uid in na) || eatStr(na[uid], 1, 120));
    }

    function eatTodayPath() {
      return /databases/$(database)/documents/eatState/today;
    }

    match /eats/{id} {
      allow read: if isMember();

      // 넣기: 적은 사람 = 나, 통 안, 작성 시각 = 서버 시각
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['food', 'place', 'memo', 'by', 'at', 'state', 'from'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.state == 'jar'
        && request.resource.data.at == request.time
        && eatContentOk(request.resource.data)
        && (!('from' in request.resource.data) || exists(/databases/$(database)/documents/eats/$(request.resource.data.from)));

      // 고치기 · 빼기 · 고르기 · 돌려놓기 · 먹었어요 · 먹은 뒤 별점 — 차례대로 아래 여섯 갈래 (식 안에는 주석을 두지 않음 — v48 배포 실패 회귀):
      //   고치기: 적은 사람만, 통 안에서만
      //   빼기: 적은 사람만, 통 안 → out
      //   고르기: 통 안 → today, 같은 쓰기 묶음에서 eatState/today가 이 쿠키를 가리켜야 함
      //   돌려놓기 (직접 · 자동): today → 통 안, eatState/today는 같은 묶음에서 지워져야 함
      //   먹었어요: today → eaten, 내 별점 · 한 줄만, eatState/today는 지워져야 함
      //   먹은 뒤 별점 · 한 줄 (자기 칸만)
      allow update: if isMember() && request.resource.data.by == resource.data.by && request.resource.data.at == resource.data.at && (
        (resource.data.by == request.auth.uid
          && resource.data.state == 'jar' && request.resource.data.state == 'jar'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['food', 'place', 'memo', 'editedAt'])
          && request.resource.data.editedAt == request.time
          && eatContentOk(request.resource.data))
        || (resource.data.by == request.auth.uid
          && resource.data.state == 'jar' && request.resource.data.state == 'out'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state']))
        || (resource.data.state == 'jar' && request.resource.data.state == 'today'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'pick'])
          && request.resource.data.pick.by == request.auth.uid
          && request.resource.data.pick.at == request.time
          && getAfter(eatTodayPath()).data.eatId == id)
        || (resource.data.state == 'today' && request.resource.data.state == 'jar'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'pick'])
          && request.resource.data.pick == null
          && !existsAfter(eatTodayPath()))
        || (resource.data.state == 'today' && request.resource.data.state == 'eaten'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'eaten', 'stars', 'notes'])
          && request.resource.data.eaten.by == request.auth.uid
          && request.resource.data.eaten.at == request.time
          && request.resource.data.eaten.together is bool
          && request.auth.uid in request.resource.data.stars
          && eatOwnScores(request.auth.uid)
          && !existsAfter(eatTodayPath()))
        || (resource.data.state == 'eaten' && request.resource.data.state == 'eaten'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stars', 'notes'])
          && eatOwnScores(request.auth.uid))
      );

      allow delete: if false;   // 빼기는 state 'out'
    }

    // 오늘 먹을 것: 둘이 같이 하나. 이미 있으면 create가 update로 바뀌어 막힘 → 앱은 「단짝이 방금 골랐어요」
    match /eatState/{doc} {
      allow read: if isMember() && doc == 'today';
      allow create: if isMember() && doc == 'today'
        && request.resource.data.keys().hasOnly(['eatId', 'by', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && getAfter(/databases/$(database)/documents/eats/$(request.resource.data.eatId)).data.state == 'today';
      allow update: if false;
      allow delete: if isMember() && doc == 'today'
        && getAfter(/databases/$(database)/documents/eats/$(resource.data.eatId)).data.state in ['jar', 'eaten'];
    }

    // 깨기 기록 (다시 뽑기에서 뺄 쿠키 · 결산용)
    match /eatDraws/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['by', 'at', 'n', 'who', 'shown', 'picked'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 3
        && request.resource.data.who in ['all', 'me', 'partner']
        && request.resource.data.shown is list && request.resource.data.shown.size() <= 3;
      allow update: if isMember() && resource.data.by == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shown', 'picked'])
        && request.resource.data.shown.size() <= 9;
      allow delete: if false;
    }
    // 출출 쿠키 꿍으로 알려 주기 (spec 8절 — 꿍 문서는 글을 못 붙여서 전용 문서): 오늘 먹을 쿠키 하나에 사람마다 한 번, 만들기만. 서버가 단짝에게 알림
    match /eatPings/{id} {
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['by', 'eatId', 'food', 'at'])
        && request.resource.data.by == request.auth.uid
        && id == request.resource.data.eatId + '_' + request.auth.uid
        && request.resource.data.at == request.time
        && get(/databases/$(database)/documents/eats/$(request.resource.data.eatId)).data.state == 'today'
        && get(/databases/$(database)/documents/eats/$(request.resource.data.eatId)).data.food == request.resource.data.food;
      allow read, update, delete: if false;
    }

    // 월말 · 연말결산 (docs/recap): recaps/<YYYY-MM | YYYY> — 서버 함수(monthlyRecap)만 쓴다. 둘 다 읽기만
    match /recaps/{key} {
      allow read: if isMember();
      allow write: if false;
    }
    // notifyLog: 서버만 쓴다 (규칙에 없으므로 앱에서는 읽기 · 쓰기 모두 막힘)
  }
}
